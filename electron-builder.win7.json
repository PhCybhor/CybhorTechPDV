{
  "appId": "com.cybhor.pdv",
  "productName": "CybhorPDV",
  "publish": [],
  "electronVersion": "22.3.27",
  "asar": true,
  "icon": "build/icon.png",
  "directories": {
    "output": "dist-win7"
  },
  "files": [
    "electron/**/*",
    "renderer/index.html",
    "renderer/styles.css",
    "renderer/dist/**/*",
    "renderer/assets/**/*",
    "build/icon.png",
    "build/env.producao",
    "!renderer/js/**/*",
    "!**/*.map"
  ],
  "asarUnpack": [
    "electron/impressao/**"
  ],
  "extraResources": [
    {
      "from": "build/env.producao",
      "to": ".env"
    }
  ],
  "win": {
    "icon": "build/icon.png",
    "executableName": "CybhorPDV",
    "requestedExecutionLevel": "asInvoker",
    "target": [
      {
        "target": "nsis"
      }
    ],
    "artifactName": "CybhorPDV-Setup-win7-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "CybhorPDV",
    "unicode": true,
    "installerLanguages": ["pt_BR"],
    "displayLanguageSelector": false
  }
}
