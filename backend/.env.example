# API CybhorPDV — copie para .env e preencha. NUNCA versione o .env.

# PostgreSQL (VPS ou docker-compose local)
DATABASE_URL=postgres://cybhor:senha-forte@localhost:5432/cybhorpdv

# Porta da API (atras do nginx na VPS)
PORT=3333

# Segredo do JWT (gere um: openssl rand -hex 32)
JWT_SEGREDO=
JWT_EXPIRACAO=12h

# CORS: dominios permitidos, separados por virgula
CORS_ORIGENS=https://seudominio.com.br

# Mercado Pago — Checkout Transparente (API Pagamentos)
MP_APP_ID=4202034511996960
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Valor mensal da assinatura por loja (R$)
ASSINATURA_VALOR_MENSAL=99.90
# URL publica da API (para o webhook do MP), ex: https://api.seudominio.com.br
URL_PUBLICA_API=
# URL publica do site (pagina de sucesso apos compra), ex: https://seudominio.com.br
URL_PUBLICA_SITE=http://localhost:3333
