# Credenciais do projeto Firebase (Console Firebase > Configuracoes do projeto > Seus apps > SDK).
# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA versione o arquivo ".env" no Git.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Impressao termica Jetway JP-800 (ESC/POS RAW, igual ao Exemplo_JP800_Delphi)
# Nome padrao apos instalar Driver_Utilitarios_JP-800/JetwayPrinterDriverJP-800.exe
IMPRESSORA_NOME=Jetway JP-800
# No Windows deixe vazio. Em Linux/dev use "teste" para gravar o .bin sem impressora.
IMPRESSORA_MODO=
# Alternativa: porta serial/COM (formaEnvio=0 do exemplo Delphi), ex: COM3
# IMPRESSORA_PORTA=
LOJA_NOME=
LOJA_CNPJ=
LOJA_ENDERECO=
LOJA_TELEFONE=

# Alerta de estoque baixo no caixa (também editável em Configurações)
ESTOQUE_MINIMO=5

# Google AI Studio (CybhorIA) — https://aistudio.google.com/apikey
# NUNCA compartilhe esta chave em chat ou commits.
GEMINI_API_KEY=
# Modelo opcional (padrão: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Licenciamento multi-loja + API de vendas
# Em desenvolvimento: chave DEV-LOCAL ativa uma loja isolada sem Mercado Pago
CYBHOR_MODO_DEV=1
CYBHOR_API_URL=http://localhost:8787
# CYBHOR_DEV_LOJA_ID=
