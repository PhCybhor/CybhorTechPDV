{
  "rules": {
    "lojas": {
      "$lojaId": {
        ".read": true,
        ".write": true,
        "funcionarios": {
          ".indexOn": ["usuario", "cargo"]
        },
        "produtos": {
          ".indexOn": ["nome", "codigoBarras"]
        },
        "vendas": {
          ".indexOn": ["criadoEm", "funcionarioId"]
        }
      }
    },
    "codigosLoja": {
      ".read": true,
      ".write": true
    }
  }
}
