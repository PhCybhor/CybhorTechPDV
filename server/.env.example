# Copie para server/.env (ou use o .env da raiz)

PORT=8787
CYBHOR_PUBLIC_URL=http://localhost:8787
CYBHOR_PRECO=297
CYBHOR_PRODUTO_NOME=CybhorPDV — Licença vitalícia
CYBHOR_MODO_DEV=1

# Mercado Pago (https://www.mercadopago.com.br/developers)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Firebase Admin (produção) — service account JSON
FIREBASE_DATABASE_URL=
# FIREBASE_SERVICE_ACCOUNT_FILE=./serviceAccount.json
# ou FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# E-mail da chave (opcional)
# SMTP_HOST=smtp.seudominio.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=vendas@seudominio.com

# Google AI Studio (opcional no servidor; o Electron usa o .env da raiz)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
