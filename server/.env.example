# API CybhorPDV (Node.js + MySQL) — copie para .env e preencha. NUNCA versione o .env.

# MySQL 8 (VPS ou docker-compose local). Caracteres especiais na senha: use %-encoding.
DATABASE_URL=mysql://user:pass@localhost:3306/cybhorpdv
# Teto de conexoes do pool (padrao 20). Ajuste sob carga.
# DB_POOL_MAX=20

# Porta da API (atras do nginx na VPS)
PORT=3333

# Segredo do JWT (gere um: openssl rand -hex 32)
JWT_SEGREDO=
JWT_EXPIRACAO=12h

# CORS: dominios permitidos, separados por virgula (nunca use * em producao).
# Em desenvolvimento, vazio libera qualquer origem.
# Em producao, liste o site publico. O desktop Electron (file://) envia Origin
# null e ja e permitido pelo servidor — nao precisa listar null aqui.
CORS_ORIGENS=

# production | development (vazio = desenvolvimento)
NODE_ENV=

# Mercado Pago (Checkout Transparente / Payment Brick).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Segredo do webhook (painel MP -> Webhooks / x-signature).
# OBRIGATORIO em producao: com NODE_ENV=production a API NAO sobe se estiver vazio.
MP_WEBHOOK_SECRET=
# Somente temporario em producao enquanto MP_WEBHOOK_SECRET nao existe (1 = aceita sem assinatura).
MP_WEBHOOK_SEM_ASSINATURA=0

# Valores da assinatura por loja (R$)
ASSINATURA_VALOR_MENSAL=99.90
ASSINATURA_VALOR_SEMESTRAL=499.90
ASSINATURA_VALOR_ANUAL=899.90

# URL publica da API (webhook do MP) e do site (retorno apos pagamento)
URL_PUBLICA_API=
URL_PUBLICA_SITE=http://localhost:3333

# Apenas desenvolvimento. Em producao o endpoint /api/admin/bootstrap fica desligado.
# ADMIN_BOOTSTRAP_SECRET=

# Opcionais: sobrescrevem os caminhos padrao (../backend/public/admin, ../landing, ../backend/downloads).
# ADMIN_DIR=
# LANDING_DIR=
# DOWNLOADS_DIR=

# --- Somente docker-compose.yml (banco local de desenvolvimento) ---
# Defina senhas locais; o compose se recusa a subir sem elas.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=cybhor
MYSQL_PASSWORD=
MYSQL_DATABASE=cybhorpdv
