{
  "name": "cybhorpdv-server",
  "version": "1.0.0",
  "description": "API CybhorPDV em Node.js (Express) + MySQL 8",
  "private": true,
  "type": "module",
  "main": "src/servidor.js",
  "scripts": {
    "start": "node src/servidor.js",
    "dev": "node --watch src/servidor.js",
    "db:schema": "node scripts/aplicarSchema.js",
    "db:migrar-pg": "node scripts/migrarPostgresParaMysql.js",
    "admin:criar": "node scripts/criarAdminSistema.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "pg": "^8.23.1"
  }
}
