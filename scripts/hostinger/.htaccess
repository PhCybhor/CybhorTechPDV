# Site (landing/) hospedado na Hostinger; a API continua na VPS.
# Na VPS estes cabecalhos vem da API (backend/app/http_seguranca.py). Aqui o
# Apache/LiteSpeed precisa envia-los. Manter a CSP igual a da API, com a VPS
# liberada em connect-src porque o site chama a API em outro dominio.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-DNS-Prefetch-Control "off"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://sdk.mercadopago.com https://http2.mlstatic.com https://www.mercadopago.com https://www.mercadopago.com.br; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://pdv.vps10229.panel.icontainer.run https://api.mercadopago.com https://api.mercadopago.com.br https://www.mercadopago.com https://www.mercadopago.com.br; frame-src https://www.mercadopago.com https://www.mercadopago.com.br https://http2.mlstatic.com; form-action 'self' https://www.mercadopago.com https://www.mercadopago.com.br"

  # Arquivos sem hash no nome: forca revalidar para o cliente nao ficar com JS antigo apos atualizar o site.
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
