{
  "name": "cybhor-pdv",
  "version": "3.2.5",
  "description": "CybhorPDV - PDV desktop para Windows 7, 8, 10 e 11 (um instalador para todos).",
  "author": "Loja",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "build:renderer:prod": "node scripts/build-renderer.mjs --ofuscar",
    "start": "npm run build:renderer && electron .",
    "test:impressao": "node scripts/testar-impressao-jp800.js",
    "dist": "npm run build:renderer:prod && node scripts/dist-windows.mjs"
  },
  "dependencies": {
    "@zxing/library": "^0.21.3",
    "chart.js": "^4.5.1",
    "dotenv": "^16.4.5",
    "fuse.js": "^7.0.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0",
    "javascript-obfuscator": "^4.1.1"
  },
  "build": {
    "appId": "com.cybhor.pdv",
    "productName": "CybhorPDV",
    "publish": [],
    "asar": true,
    "icon": "build/icon.png",
    "files": [
      "electron/**/*",
      "renderer/index.html",
      "renderer/styles.css",
      "renderer/dist/**/*",
      "renderer/assets/**/*",
      "build/icon.png",
      "build/env.producao",
      "!renderer/js/**/*",
      "!**/*.map"
    ],
    "asarUnpack": [
      "electron/impressao/**"
    ],
    "extraResources": [
      {
        "from": "build/env.producao",
        "to": ".env"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "executableName": "CybhorPDV",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis"
        }
      ],
      "artifactName": "CybhorPDV-Setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CybhorPDV",
      "unicode": true,
      "installerLanguages": [
        "pt_BR"
      ],
      "displayLanguageSelector": false
    }
  }
}
