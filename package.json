{
  "name": "cybhor-pdv",
  "version": "2.1.6",
  "description": "CybhorPDV - PDV desktop para Windows 7 e Windows 10+.",
  "author": "Loja",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "build:renderer:prod": "node scripts/build-renderer.mjs --ofuscar",
    "start": "npm run build:renderer && electron .",
    "test:impressao": "node scripts/testar-impressao-jp800.js",
    "dist": "npm run dist:win10",
    "dist:win10": "npm run build:renderer:prod && electron-builder --win nsis --x64 --publish never -c.win.signAndEditExecutable=false",
    "dist:prod": "npm run dist:win10",
    "dist:win7": "npm run build:renderer:prod && node scripts/dist-win7.mjs",
    "dist:nsis": "npm run dist:win10"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "dotenv": "^16.4.5",
    "fuse.js": "^7.0.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0",
    "javascript-obfuscator": "^4.1.1"
  },
  "build": {
    "appId": "com.cybhor.pdv",
    "productName": "CybhorPDV",
    "publish": [],
    "asar": true,
    "icon": "build/icon.png",
    "files": [
      "electron/**/*",
      "renderer/index.html",
      "renderer/styles.css",
      "renderer/dist/**/*",
      "renderer/assets/**/*",
      "build/icon.png",
      "build/env.producao",
      "!renderer/js/**/*",
      "!**/*.map"
    ],
    "asarUnpack": [
      "electron/impressao/**"
    ],
    "extraResources": [
      {
        "from": "build/env.producao",
        "to": ".env"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CybhorPDV-Setup-win10-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CybhorPDV",
      "unicode": true,
      "installerLanguages": [
        "pt_BR"
      ]
    }
  }
}
