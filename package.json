{
  "name": "cybhor-pdv",
  "version": "2.0.0",
  "description": "CybhorPDV 2.0 - PDV completo com caixa, gestao de produtos, relatorios, equipe, troco e Firebase Realtime Database.",
  "author": "Loja",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "start": "npm run build:renderer && electron .",
    "test:impressao": "node scripts/testar-impressao-jp800.js",
    "dist": "npm run dist:win10",
    "dist:win10": "npm run build:renderer && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win zip nsis --x64 -c.win.signAndEditExecutable=false",
    "dist:win7": "npm run build:renderer && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win zip --x64 --ia32 -c.win.signAndEditExecutable=false -c.electronVersion=22.3.27",
    "dist:nsis": "npm run build:renderer && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --x64 -c.win.signAndEditExecutable=false"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "dotenv": "^16.4.5",
    "firebase": "^10.12.2",
    "fuse.js": "^7.0.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0"
  },
  "build": {
    "appId": "com.cybhor.pdv",
    "productName": "CybhorPDV",
    "asar": true,
    "icon": "build/icon.png",
    "files": [
      "electron/**/*",
      "renderer/index.html",
      "renderer/styles.css",
      "renderer/dist/**/*",
      "renderer/assets/**/*",
      "!renderer/js/**/*",
      "!**/*.map"
    ],
    "asarUnpack": [
      "electron/impressao/**"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CybhorPDV-${version}-win10-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "CybhorPDV"
    }
  }
}
