{
  "name": "cybhor-pdv",
  "version": "1.0.0",
  "description": "CybhorPDV - Sistema de PDV para loja com Firebase Realtime Database, busca inteligente de produtos, desconto e controle de acesso por administrador.",
  "author": "Loja",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder --win --x64",
    "dist:win": "npm run build:renderer && electron-builder --win --x64 --config.directories.output=%TEMP%\\cybhor-pdv-dist"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "dotenv": "^16.4.5",
    "firebase": "^10.12.2",
    "fuse.js": "^7.0.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0"
  },
  "build": {
    "appId": "com.cybhor.pdv",
    "productName": "CybhorPDV",
    "asar": true,
    "icon": "build/icon.png",
    "files": [
      "electron/**/*",
      "renderer/index.html",
      "renderer/styles.css",
      "renderer/dist/**/*",
      "renderer/assets/**/*",
      "!renderer/js/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CybhorPDV-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "CybhorPDV"
    }
  }
}
