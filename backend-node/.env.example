# API CybhorPDV (Node.js + MySQL/MariaDB) — copie para .env e preencha. NUNCA versione o .env.
# Os nomes são os mesmos do backend Python; o que muda é o DATABASE_URL.

# MySQL/MariaDB. Na Hostinger: hPanel > Bancos de dados MySQL (host costuma ser localhost).
# Senha com caracteres especiais precisa de URL-encoding (@ vira %40, # vira %23).
DATABASE_URL=mysql://usuario:senha@localhost:3306/cybhorpdv
# Conexões simultâneas no pool. Hospedagem compartilhada limita conexões por usuário.
# DB_POOL_MAX=10

# Porta da API. Na Hostinger (Web Apps Node) o painel define PORT sozinho.
PORT=3333
# Proxies reversos à frente da API (nginx/LiteSpeed da hospedagem = 1).
# Define de onde sai o IP do cliente para rate limit e registro do aceite.
PROXIES_CONFIAVEIS=1

# Segredo do JWT (gere um: openssl rand -hex 32). Use o MESMO do backend Python
# para que sessões abertas continuem válidas na troca.
JWT_SEGREDO=
JWT_EXPIRACAO=12h

# CORS: domínios permitidos, separados por vírgula (nunca use * em produção).
# Em desenvolvimento, vazio libera qualquer origem. O desktop Electron (file://)
# envia Origin null e já é aceito pelo servidor.
CORS_ORIGENS=https://cybhor.tech,https://www.cybhor.tech

# production | development | test (vazio = desenvolvimento)
NODE_ENV=

# Mercado Pago — produção (Checkout Transparente / Payment Brick).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Segredo do webhook (painel MP > Webhooks / x-signature). Obrigatório em produção.
MP_WEBHOOK_SECRET=
# Somente temporário em produção enquanto MP_WEBHOOK_SECRET não existe (1 = aceita sem assinatura).
MP_WEBHOOK_SEM_ASSINATURA=0
# Valores da assinatura por loja (R$)
ASSINATURA_VALOR_MENSAL=99.90
ASSINATURA_VALOR_SEMESTRAL=499.90
ASSINATURA_VALOR_ANUAL=899.90
# URL pública da API (webhook do MP) e do site (retorno após pagamento)
URL_PUBLICA_API=
URL_PUBLICA_SITE=https://cybhor.tech

# Pasta com os instaladores (downloads/versoes/<versao>/...). Vazio = procura nas pastas padrão.
# PASTA_DOWNLOADS=

# Apenas desenvolvimento. Em produção o endpoint /api/admin/bootstrap fica desligado.
# ADMIN_BOOTSTRAP_SECRET=
